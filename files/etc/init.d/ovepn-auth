#!/bin/sh /etc/rc.common
# shellcheck disable=2034
START=89
STOP=11
USE_PROCD=1
boot() {
  # no tunnel at boot, drop dns servers left after unclean shutdown
  if [ -s '/etc/dnsmasq.d/ovepn.conf' ]; then
    rm -f '/etc/dnsmasq.d/ovepn.conf'
    /etc/init.d/dnsmasq restart
  else
    rm -f '/etc/dnsmasq.d/ovepn.conf'
  fi
  start "$@"
}
start_service() {
  [ -p '/var/run/ovepn.auth' ] || {
    rm -f '/var/run/ovepn.auth'
    mkfifo -m 600 '/var/run/ovepn.auth'
  }
  procd_open_instance
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 5 -1
  procd_set_param command /usr/libexec/ovepn-auth.sh
  procd_close_instance
}
